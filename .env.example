# .env.example — copy to .env and fill in, then: docker compose up -d
#
#   cp .env.example .env && chmod 600 .env
#
# .env holds live credentials and is gitignored. Never commit it.

# --- Private Internet Access account ---------------------------------------
# PIA_USER  : your PIA username, looks like  p1234567
# PIA_PASS  : your PIA password
PIA_USER=
PIA_PASS=

# PIA region that supports PORT FORWARDING (required for good torrent speeds).
# US regions do NOT support port forwarding. Good choices:
#   CA Toronto | CA Montreal | Netherlands | Switzerland | Romania | Czech Republic
PIA_REGION=

# --- Common container settings -------------------------------------------------
PUID=
PGID=
TZ=

# --- Optional: qBittorrent Web UI login -------------------------------------
# QBITTORRENT_PASSWORD is NOT used by port-sync (it talks to qBittorrent over
# localhost with auth bypassed). Left here for reference / other tooling.
QBITTORRENT_PASSWORD=

# configure-qbittorrent.sh sets the Web UI login ONLY if you fill these in.
# Leave them blank and it will not touch the password you set in the Web UI.
# Never put a hash in a tracked file -- this repo is public, and a committed
# hash is a published credential that can be cracked offline.
#
# Generate the hash (prompts, echoes nothing, random salt each run):
#   python3 -c 'import base64,hashlib,getpass,os;p=getpass.getpass().encode();s=os.urandom(16);print("@ByteArray(%s:%s)"%(base64.b64encode(s).decode(),base64.b64encode(hashlib.pbkdf2_hmac("sha512",p,s,100000,64)).decode()))'
#
# Paste the whole @ByteArray(...) string, unquoted:
#   QBITTORRENT_PASSWORD_PBKDF2=@ByteArray(c2FsdA==:aGFzaA==)
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD_PBKDF2=

# --- Port-sync (GSP mod on the qbittorrent container) ----------------------
# Must match apikey in appdata/gluetun/auth/config.toml. Regenerate both
# together with:  openssl rand -hex 32
GSP_GTN_API_KEY=

# --- Recyclarr (TRaSH quality profiles + custom formats) --------------------
# Recyclarr needs read/write API access to Sonarr and Radarr. Each app's key is
# in its own config.xml, which is gitignored. Pull both into .env with:
#
#   cd /mnt/calculon/media-stack
#   for a in sonarr radarr; do
#     printf '%s_API_KEY=%s\n' "${a^^}" \
#       "$(sed -n 's:.*<ApiKey>\(.*\)</ApiKey>.*:\1:p' appdata/$a/config.xml)"
#   done >> .env
#
# Then dry-run before anything is written:
#   docker compose run --rm recyclarr sync --preview
SONARR_API_KEY=
RADARR_API_KEY=

# --- Remote access: DuckDNS + Caddy ----------------------------------------
# Sign in at https://www.duckdns.org (GitHub/Google/Reddit login), create a
# subdomain, and copy the token shown at the top of the page.
#   DUCKDNS_SUBDOMAIN : just the label, e.g. "farnsworth" for
#                       farnsworth.duckdns.org  (no ".duckdns.org")
#   DUCKDNS_TOKEN     : the uuid-looking token on the DuckDNS page
#   ACME_EMAIL        : where Let's Encrypt sends cert-expiry warnings
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
ACME_EMAIL=
