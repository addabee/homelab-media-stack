# storj-monitor configuration
# Alerts go to ntfy.sh by default. The topic name is the ONLY access control —
# anyone who knows it can read your alerts, so keep it private.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# Optional: have ntfy forward each alert to this address as well.
# NOTE: ntfy.sh REJECTS anonymous email sending (HTTP 400). This only works with
# a free ntfy.sh account plus an access token in NTFY_TOKEN below. Leaving
# NTFY_EMAIL set without a token breaks ALL notifications, not just email.
NTFY_EMAIL=
NTFY_TOKEN=

# To use something else instead (Discord/Slack webhook, Telegram, a local
# script), set NOTIFY_CMD. It receives the alert body on stdin and the title
# in $STORJ_TITLE, and takes precedence over ntfy. Example:
# NOTIFY_CMD=curl -s -X POST -H 'Content-Type: application/json' -d "$(jq -Rs '{content:.}')" https://discord.com/api/webhooks/...

# Thresholds
PING_MAX_MIN=20
DISK_USED_PCT=90
ARRAY_FREE_MIN_GB=250
SCORE_MIN=0.96

# Pop a local desktop notification as well as the remote alert. Additive, not a
# replacement. No-op when there is no graphical session, so it is safe to leave
# on for a headless host.
DESKTOP_NOTIFY=1
